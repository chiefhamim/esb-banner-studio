{
  "name": "esb-banner-studio",
  "private": true,
  "version": "1.6.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync": "node tools/git-sync.mjs",
    "test:golden": "node tools/e2e/golden-test.mjs",
    "test:ui": "node tools/e2e/ui-test.mjs && node tools/e2e/date-test.mjs",
    "test:editorial": "node tools/e2e/editorial-test.mjs",
    "test:insights": "node tools/e2e/insights-test.mjs",
    "test:wire": "node tools/e2e/wire-test.mjs",
    "test:digest": "node tools/e2e/digest-test.mjs",
    "test:video": "node tools/e2e/video-test.mjs && node tools/e2e/video-engine-test.mjs && node tools/e2e/video-fx-test.mjs && node tools/e2e/video-titles-test.mjs",
    "test:unit": "vitest run",
    "preapp": "node tools/ensure-deps.mjs",
    "app": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win dir",
    "test": "vitest run",
    "census": "node tools/audit/css-census.mjs",
    "test:extract": "node tools/e2e/extract-test.mjs",
    "test:electron": "node tools/e2e/electron-test.mjs && node tools/e2e/video-electron-test.mjs",
    "audit:center": "node tools/audit/center-audit.mjs",
    "audit:text-fit": "node tools/audit/text-fit-audit.mjs",
    "audit:contrast": "node tools/audit/contrast-audit.mjs",
    "audit:a11y": "node tools/audit/a11y-audit.mjs",
    "audit:suite": "node tools/audit/capture-visual-suite.mjs",
    "audit:pdf": "node tools/audit/generate-pdf-report.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fontsource/source-serif-4": "^5.3.1",
    "@fontsource/space-grotesk": "^5.3.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "imapflow": "2.4.0",
    "mammoth": "^1.13.0",
    "mediabunny": "^1.62.1",
    "nodemailer": "10.1.4",
    "pdfjs-dist": "^6.4.299",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "9.3.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "productName": "ESB AI Studio",
  "description": "ESB AI Studio — ESB PowerLine newsroom workstation: editorial, graphics and video",
  "author": "Hamim Ruwayfi (ESB PowerLine)",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.esbpowerline.bannerstudio",
    "productName": "ESB AI Studio",
    "directories": {
      "output": "release-v1.5.4",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "electronDist": "node_modules/electron/dist",
    "electronVersion": "45.0.0",
    "win": {
      "target": "dir",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "asar": true
  }
}
